{
  "name": "synaptex",
  "version": "0.1.6",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "dev:desktop": "concurrently -k -n next,electron \"next dev -p 3000\" \"wait-on http-get://localhost:3000 && electron . --dev\"",
    "start:desktop": "next build && electron .",
    "package:desktop": "node scripts/fetch-tectonic.mjs && next build && electron-builder",
    "package:dir": "node scripts/fetch-tectonic.mjs && next build && electron-builder --dir"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@uiw/react-codemirror": "^4.25.12",
    "concurrently": "^10.0.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "next": "16.4.3",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.5.1"
  },
  "description": "Lokale, quelloffene LaTeX-Desktop-Anwendung",
  "main": "electron/main.mjs",
  "build": {
    "appId": "io.github.synaptex.app",
    "productName": "SynapTeX",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "electron/**",
      "out/**",
      "package.json",
      "assets/icon.png"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "extraResources": [
      {
        "from": "vendor/tectonic",
        "to": "tectonic"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "Teoman951",
      "repo": "synaptex",
      "releaseType": "release"
    }
  },
  "license": "AGPL-3.0-only",
  "private": true,
  "author": "Teoman951",
  "repository": "github:Teoman951/synaptex"
}
